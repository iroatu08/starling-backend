<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Booking Confirmed</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; padding: 0; background: #f8f6f2; color: #1b2a4a; }
    .container { max-width: 600px; margin: 40px auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #1b2a4a 0%, #2d4a7a 100%); padding: 40px; text-align: center; }
    .header h1 { color: #c49a2d; margin: 0; font-size: 28px; font-family: Georgia, serif; }
    .badge { display: inline-block; background: #c49a2d; color: #fff; padding: 6px 16px; border-radius: 20px; font-size: 14px; margin-top: 10px; }
    .body { padding: 40px; }
    .ref-box { background: #1b2a4a; color: #c49a2d; padding: 20px; border-radius: 8px; text-align: center; margin: 20px 0; }
    .ref-box span { font-size: 24px; font-weight: bold; letter-spacing: 2px; }
    table { width: 100%; border-collapse: collapse; margin: 16px 0; }
    th { background: #f8f6f2; padding: 10px 12px; text-align: left; font-size: 13px; color: #6b7280; }
    td { padding: 10px 12px; border-bottom: 1px solid #f0f0f0; font-size: 14px; }
    .group-title { font-size: 15px; font-weight: bold; color: #1b2a4a; margin: 24px 0 8px; }
    .muted { color: #6b7280; font-size: 14px; margin: 12px 0; }
    .total { font-weight: bold; font-size: 16px; text-align: right; padding: 16px 12px; }
    .footer { padding: 24px 40px; text-align: center; font-size: 12px; color: #6b7280; border-top: 1px solid #f0f0f0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Starlings Hospitality</h1>
      <div class="badge">Booking Confirmed</div>
    </div>
    <div class="body">
      <h2>Great news, {{firstName}}!</h2>
      <p>Your booking has been confirmed. Here are your booking details:</p>
      <div class="ref-box">
        <p style="color:#fff;margin:0 0 4px;font-size:12px;">BOOKING REFERENCE</p>
        <span>{{referenceNumber}}</span>
      </div>
      {{#if destinationsSummary}}
      <p class="muted">Your trip includes: {{destinationsSummary}}</p>
      {{/if}}
      {{#each destinationGroups}}
      <p class="group-title">{{destinationName}}{{#if country}} — {{country}}{{/if}}</p>
      <table>
        <thead>
          <tr>
            <th>Item</th>
            <th>Qty</th>
            <th>Line total</th>
          </tr>
        </thead>
        <tbody>
          {{#each lines}}
          <tr>
            <td>{{title}}</td>
            <td>{{quantity}}</td>
            <td>₦{{lineTotalNgn}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/each}}
      <div class="total">Total: ₦{{totalAmount}}</div>
      <p>Please complete your payment to secure your booking. Our team will contact you with further details within 24 hours.</p>
    </div>
    <div class="footer">
      <p>Starlings Hospitality | Booked on {{createdAt}}</p>
    </div>
  </div>
</body>
</html>
