# App
NODE_ENV=development
PORT=3001
# Primary app URL (emails, Paystack callbacks). In development, CORS also allows http://localhost:5174 when Vite picks the next port.
FRONTEND_URL=http://localhost:5173
# Optional comma-separated origins. When set (e.g. on Render), CORS allows every listed origin — use for prod API + local Vite hitting the same host:
# ALLOWED_ORIGINS=https://starlings-web.vercel.app,http://localhost:5173
ADMIN_EMAIL=admin@starlingshsp.com

# JWT (HS256)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://starlings:starlings_pass@localhost:5432/starlings_db
# Optional override: true|false. When unset, SSL is auto-enabled for remote hosts (Railway etc.) and off for localhost.
# DB_SSL=true

# Email — Resend HTTP API (https://resend.com/docs/api-reference/emails/send-email)
# Uses HTTPS (port 443), so it works when SMTP ports are blocked.
# MAIL_FROM must use a verified domain or onboarding@resend.dev for testing.
RESEND_API_KEY=
MAIL_FROM="Starlings Hospitality <onboarding@resend.dev>"

# Paystack
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry
SENTRY_DSN=
